# PolicyLens Environment Configuration
# Copy to .env and adjust values for your deployment

# LLM Provider: "gemini" | "anthropic" | "none" (default: none for extractive mode)
LLM_PROVIDER=none

# Gemini API key (if using gemini provider)
# GEMINI_API_KEY=your_key_here

# Anthropic API key (if using anthropic provider)
# ANTHROPIC_API_KEY=your_key_here

# FAISS index threshold for confidence gate
# Lower = more permissive (more likely to answer), Higher = more conservative
# Calibrate with scripts/calibrate_threshold.py
CONFIDENCE_THRESHOLD=0.35

# PDF upload temp directory
PDF_UPLOAD_DIR=uploads

# Trace/logging configuration
TRACE_DIR=.cache

# Maximum pages allowed per PDF upload
MAX_PAGES=50

# Maximum file size for PDF uploads (in MB)
MAX_UPLOAD_SIZE_MB=10